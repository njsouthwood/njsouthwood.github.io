# Terminal-game gate answers. Copy this file to .env.local and fill in the real
# answers, then run:  node scripts/hash-answers.js
# Paste the printed answerHash lines into the matching nodes in js/terminal.js.
#
# .env.local is gitignored — the plaintext answers never get committed.
#
# Each var is a COMMA-SEPARATED list of every accepted spelling for that gate.

# termOn gate (the decoded Caesar word)
TERM_ANSWERS=answer

# serverSealed gate (the riddle; include synonyms)
RIDDLE_ANSWERS=answer,a answer,synonym

# safe gate (the 4-digit code)
SAFE_ANSWERS=0000

# Test backdoor: typing this phrase wins instantly from any mode (for testing
# the win page). Leave unset to disable the backdoor.
BACKDOOR_ANSWER=some secret phrase

# Optional — must match hashConfig in js/terminal.js if you change them.
# HASH_SALT=njs-terminal-v1::
# HASH_ITERATIONS=2000
